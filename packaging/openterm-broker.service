[Unit]
Description=Openterm privileged-session token broker
Documentation=man:openterm(1)
After=local-fs.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/lib/openterm/openterm-broker
Restart=on-failure
RuntimeDirectory=openterm
RuntimeDirectoryMode=0755

[Install]
WantedBy=multi-user.target
