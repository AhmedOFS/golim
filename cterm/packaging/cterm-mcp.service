# --- cterm-mcp.service ---
# This file should be installed to /usr/lib/systemd/user/ by the .deb package.

[Unit]
Description=CTerm MCP Tool Server (UDS/Inactivity Shutdown)
# This service is started on demand by the cterm CLI client.

[Service]
# Type=simple means the process remains in the foreground as the main service process.
Type=simple
# Standard user environment variables are passed to the service.
Environment=PYTHONUNBUFFERED=1
# Replace /usr/bin/cterm_server with the actual installation path of the script
ExecStart=/usr/bin/python3 -m cterm_server
# If the server exits successfully (due to inactivity timeout), we don't restart it.
Restart=on-failure 
# No timeout needed, as the server manages its own inactivity timeout and graceful exit.
# This prevents systemd from automatically cleaning up the socket file.

[Install]
# This section is optional but can be used if you want the user to be able to enable/disable it.
# We will rely on manual start via systemctl --user start from the CLI.
WantedBy=default.target